ENVIRONMENT=dev
DATABASE_URL=postgresql+psycopg://compedu:change-me@localhost:5432/compedu
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_MINUTES=60
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Google OAuth2 (Google Identity Services)
GOOGLE_CLIENT_ID=
ALLOWED_DOMAIN=

# Habilita login por e-mail/senha para desenvolvimento e testes (desative em produção: false)
AUTH_DEV_LOGIN=false
